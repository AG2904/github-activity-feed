# Copy to .env for local development. Never commit .env.
# The relay loads this file at boot; shell exports win over these values.
# The relay refuses to boot if GITHUB_WEBHOOK_SECRET is not set.
GITHUB_WEBHOOK_SECRET=change-me
# SQLite database file. Defaults to ./relay.db when unset.
# DATABASE_PATH=./relay.db
# HTTP port. Defaults to 3000 when unset.
# PORT=3000
# Stream heartbeat interval in milliseconds. Defaults to the built-in value.
# STREAM_HEARTBEAT_MS=15000
