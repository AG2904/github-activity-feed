{
  "name": "github-activity-feed",
  "version": "1.0.0",
  "description": "Critical GitHub events as a terminal activity feed: a signed webhook relay (NestJS + SQLite) streaming over SSE, and a Go CLI that renders it.",
  "author": "AG2904",
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run --config ./vitest.config.e2e.ts",
    "cli:build": "cd client && node tools/build.mjs",
    "cli:dist": "cd client && node tools/build.mjs --dist",
    "cli:test": "cd client && go test -count=1 ./...",
    "cli:lint": "cd client && go vet ./..."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AG2904/github-activity-feed.git"
  },
  "keywords": [
    "github",
    "webhooks",
    "sse",
    "cli",
    "golang",
    "nestjs",
    "sqlite",
    "terminal"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/AG2904/github-activity-feed/issues"
  },
  "homepage": "https://github.com/AG2904/github-activity-feed#readme",
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
